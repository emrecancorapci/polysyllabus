---
/**
 * Figure lightbox: one native <dialog> reused for every zoomable figure on
 * the page. Sources: [data-zoomable] (Figure blocks and PNGs) and Mermaid
 * diagrams (svg[id^="mermaid-"]). Clicking a source clones it into the
 * dialog at full size; Esc, the close button, or a backdrop click closes.
 * The script in src/lib/lightbox-client.ts does the wiring.
 */
---

<dialog
  id="figure-lightbox"
  aria-label="Enlarged figure"
  class="bg-card text-foreground border-border p-3"
>
  <div class="mb-2 flex justify-end">
    <button
      type="button"
      data-lightbox-close
      aria-label="Close enlarged figure"
      class="hover:bg-accent rounded-md p-1.5 focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>
  <div
    data-lightbox-content
    class="grid place-items-center overflow-auto"
  ></div>
</dialog>

<script>
import { initLightbox } from "@/lib/lightbox-client";
initLightbox();
</script>
