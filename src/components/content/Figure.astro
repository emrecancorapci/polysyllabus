---
/**
 * Numbered, captioned figure. Authors write the markdown image as the child:
 *
 *   <Figure caption="What the figure shows">![alt text](./fig-*.svg)</Figure>
 *
 * The rehype plugin (src/plugins/rehype-content.ts) validates the image,
 * resolves `src` to a repo-absolute path, and injects `figureLabel`
 * ("lessonOrder.figureIndex") before this component renders.
 * SVG sources are inlined so `currentColor` follows the theme.
 */

import { readFileSync } from "node:fs";
import { join } from "node:path";

const svgSources = import.meta.glob("/src/docs/courses/**/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const pngSources = import.meta.glob("/src/docs/courses/**/*.png", {
  query: "?url",
  import: "default",
  eager: true,
}) as Record<string, string>;

interface Props {
  /** Repo-absolute path, injected by the rehype plugin. */
  src: string;
  /** Injected from the inner markdown image. */
  alt: string;
  /** Figure caption; the visible "Figure N.M" prefix is added automatically. */
  caption: string;
  /** "lessonOrder.figureIndex", injected. */
  figureLabel?: string;
}

const { src, alt, caption, figureLabel } = Astro.props;

const svg = svgSources[src];
const png = pngSources[src];
if (svg === undefined && png === undefined) {
  throw new Error(`[Figure] file not found beside the lesson: ${src}`);
}

/** Read the IHDR header so the <img> reserves space and never shifts layout. */
function pngDimensions(path: string): { width: number; height: number } {
  const bytes = readFileSync(join(process.cwd(), path));
  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
  return { width: view.getUint32(16), height: view.getUint32(20) };
}
---

<figure class="not-prose my-6 flex flex-col gap-2">
  {svg !== undefined ? (
    <div
      class="text-foreground grid-paper border-border bg-card flex justify-center rounded-lg border p-4 [&_svg]:h-auto [&_svg]:max-h-96 [&_svg]:w-auto [&_svg]:max-w-full"
      role="img"
      aria-label={alt}
      set:html={svg}
    />
  ) : (
    (() => {
      const { width, height } = pngDimensions(src);
      return (
        <img
          src={png}
          alt={alt}
          width={width}
          height={height}
          loading="lazy"
          decoding="async"
          class="border-border bg-card grid-paper mx-auto rounded-lg border p-4"
        />
      );
    })()
  )}
  <figcaption class="text-muted-foreground text-center text-sm">
    {figureLabel && (
      <span class="text-foreground font-medium">Figure {figureLabel}. </span>
    )}
    {caption}
  </figcaption>
</figure>
