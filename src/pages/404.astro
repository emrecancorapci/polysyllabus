---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Page not found — PolySyllabus"
  description="That course, lesson, or part does not exist."
>
  <main
    id="main"
    class="mx-auto flex w-full max-w-2xl flex-1 flex-col items-start justify-center gap-4 px-6 py-24"
  >
    <h1 class="font-heading text-5xl font-semibold tracking-tight">404</h1>
    <p class="text-muted-foreground text-pretty">
      That course, lesson, or part does not exist. It may have been renamed or
      not yet published.
    </p>
    <a
      href="/"
      class="text-primary rounded-sm text-sm font-medium underline-offset-4 hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
    >
      Back to all courses
    </a>
  </main>
</Base>
