---
import "@/styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <title>Page not found — PolySyllabus</title>
  </head>
  <body class="bg-background text-foreground">
    <main
      class="mx-auto flex min-h-screen w-full max-w-2xl flex-col items-center justify-center gap-4 px-6 text-center"
    >
      <h1 class="text-4xl font-semibold tracking-tight">404</h1>
      <p class="text-muted-foreground">
        That course, lesson, or part does not exist. It may have been renamed or
        not yet published.
      </p>
      <a href="/" class="text-primary underline-offset-4 hover:underline">
        Back to all courses
      </a>
    </main>
  </body>
</html>
