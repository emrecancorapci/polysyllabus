---
import "@/styles/global.css";
import { Button, buttonVariants } from "@/components/ui/button";
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <title>Study Helper</title>
  </head>
  <body
    class="bg-background flex min-h-screen flex-col items-center justify-center"
  >
    <main class="flex flex-col items-center gap-4 px-6 text-center">
      <h1 class="text-3xl font-semibold tracking-tight">Study Helper</h1>
      <p class="text-muted-foreground max-w-md">
        Structured courses for electrical and electronics engineering. Content
        is on the way.
      </p>
      <Button client:load onClick={() => alert("React islands work!")}>
        Get started
      </Button>
      <a
        href="/courses/dc-circuits/1-ohms-law/"
        class={buttonVariants({ variant: "outline" })}
      >
        Browse the sample lesson
      </a>
    </main>
  </body>
</html>
