---
import { getCourses } from "@/lib/courses";
import ThemeInit from "@/components/chrome/ThemeInit.astro";
import ThemeToggle from "@/components/chrome/ThemeToggle.astro";
import "@/styles/global.css";

const courses = await getCourses();
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <title>Study Helper</title>
    <ThemeInit />
  </head>
  <body class="bg-background text-foreground">
    <ThemeToggle />
    <main class="mx-auto flex w-full max-w-3xl flex-col gap-10 px-6 py-16">
      <section class="flex flex-col items-center gap-4 text-center">
        <h1 class="text-4xl font-semibold tracking-tight">Study Helper</h1>
        <p class="text-muted-foreground max-w-md">
          Structured courses for electrical and electronics engineering.
        </p>
      </section>
      <section aria-label="Courses" class="flex flex-col gap-4">
        <h2 class="text-lg font-semibold">Courses</h2>
        {courses.map((course) => (
          <a
            href={`/courses/${course.slug}/`}
            class="border-border bg-card hover:border-primary/40 flex flex-col gap-1 rounded-lg border p-5 transition-colors"
          >
            <span class="text-lg font-medium">{course.title}</span>
            <span class="text-muted-foreground text-sm">
              {course.lessons.length} lesson
              {course.lessons.length === 1 ? "" : "s"} ·{" "}
              {course.lessons.reduce(
                (total, lesson) => total + lesson.data.estimatedTime,
                0,
              )}{" "}
              min
            </span>
          </a>
        ))}
      </section>
    </main>
  </body>
</html>
