---
import Base from "@/layouts/Base.astro";
import {
  getCourses,
  lessonFirstPartHref,
  partHref,
  totalMinutes,
} from "@/lib/courses";
import ProgressEnhance from "@/components/chrome/ProgressEnhance.astro";

export async function getStaticPaths() {
  const courses = await getCourses();
  return courses.map((course) => ({
    params: { course: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const allParts = course.lessons.flatMap((lesson) => lesson.parts);
const lessonCount = `${course.lessons.length} ${course.lessons.length === 1 ? "lesson" : "lessons"}`;
const partCount = `${allParts.length} ${allParts.length === 1 ? "part" : "parts"}`;
const stats = [
  lessonCount,
  partCount,
  `${totalMinutes(allParts)} min total`,
].join(", ");
---

<Base title={`${course.title} — PolySyllabus`} description={course.summary}>
  <main
    id="main"
    class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-10 px-6 py-12"
  >
    <nav aria-label="Breadcrumb" class="text-muted-foreground text-sm">
      <a
        href="/"
        class="hover:text-foreground rounded-sm focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
      >
        Home
      </a>
      <span aria-hidden="true"> / </span>
      <span class="text-foreground">{course.title}</span>
    </nav>

    <header class="flex flex-col gap-3">
      <h1 class="font-heading text-4xl font-semibold tracking-tight">
        {course.title}
      </h1>
      <div
        class="text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
      >
        <span>
          {course.category}
          <span aria-hidden="true">→</span>
          {course.subCategory}
        </span>
        <span
          class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-xs capitalize"
        >
          {course.difficulty}
        </span>
      </div>
      {course.summary && (
        <p class="text-muted-foreground max-w-prose text-pretty">
          {course.summary}
        </p>
      )}
      <p class="text-muted-foreground text-sm tabular-nums">
        {stats}
      </p>
      <div class="mt-1 flex items-center gap-3">
        <div
          class="bg-muted h-1.5 w-56 max-w-full overflow-hidden rounded-full"
          role="progressbar"
          aria-label={`Course progress: ${allParts.length} parts`}
          aria-valuemin="0"
          aria-valuemax={allParts.length}
          aria-valuenow="0"
          data-course-progress
          data-course={course.slug}
          data-total={allParts.length}
        >
          <div class="bg-primary h-full w-0" data-course-progress-bar></div>
        </div>
        <span
          data-course-progress-label
          aria-live="polite"
          class="text-muted-foreground text-xs tabular-nums"
        >
          0 of {allParts.length} parts completed
        </span>
      </div>
    </header>

    <div class="flex flex-col">
      {course.lessons.map((lesson) => (
        <section
          aria-labelledby={`lesson-${lesson.slug}`}
          class="border-border border-t py-7 first:border-t-0 first:pt-2"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2
              id={`lesson-${lesson.slug}`}
              class="font-heading flex items-baseline gap-2.5 text-xl font-semibold tracking-tight"
            >
              <span class="text-muted-foreground tabular-nums">
                {lesson.order}.
              </span>
              <span>{lesson.title}</span>
            </h2>
            <span class="text-muted-foreground text-sm whitespace-nowrap tabular-nums">
              {totalMinutes(lesson.parts)} min
            </span>
          </div>
          {lesson.summary && (
            <p class="text-muted-foreground mt-1.5 text-sm max-sm:text-pretty">
              {lesson.summary}
            </p>
          )}
          <ol class="mt-3 flex flex-col">
            {lesson.parts.map((part) => (
              <li>
                <a
                  href={partHref(part)}
                  data-lesson-id={part.id}
                  class="group -mx-2 flex items-baseline gap-2.5 rounded-md px-2 py-2 transition-colors hover:bg-muted/50 focus-visible:bg-muted/50 focus-visible:outline-none"
                >
                  <span class="text-muted-foreground w-9 shrink-0 text-sm tabular-nums">
                    {lesson.order}.{part.data.order}
                  </span>
                  <span class="min-w-0 flex-1 truncate text-[0.95rem] group-hover:text-primary transition-colors">
                    {part.data.title}
                  </span>
                  <span
                    data-check-slot
                    class="text-success text-sm font-medium"
                    aria-hidden="true"
                  />
                  <span data-quiz-slot class="text-xs" aria-hidden="true" />
                  <span class="text-muted-foreground/70 text-xs whitespace-nowrap tabular-nums">
                    {part.data.estimatedTime} min
                  </span>
                </a>
              </li>
            ))}
          </ol>
          {lessonFirstPartHref(lesson) && (
            <a
              href={lessonFirstPartHref(lesson)}
              class="text-primary mt-3 inline-block rounded-sm px-0.5 text-sm font-medium underline-offset-4 hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              Start lesson
            </a>
          )}
        </section>
      ))}
    </div>
  </main>
  <ProgressEnhance />
</Base>
