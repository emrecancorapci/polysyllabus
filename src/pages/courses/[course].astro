---
import {
  getCourses,
  lessonFirstPartHref,
  partHref,
  totalMinutes,
} from "@/lib/courses";
import ProgressEnhance from "@/components/chrome/ProgressEnhance.astro";
import ThemeInit from "@/components/chrome/ThemeInit.astro";
import ThemeToggle from "@/components/chrome/ThemeToggle.astro";
import "@/styles/global.css";

export async function getStaticPaths() {
  const courses = await getCourses();
  return courses.map((course) => ({
    params: { course: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const allParts = course.lessons.flatMap((lesson) => lesson.parts);
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <title>{course.title} — PolySyllabus</title>
    <ThemeInit />
  </head>
  <body class="bg-background text-foreground">
    <ThemeToggle />
    <main class="mx-auto flex w-full max-w-3xl flex-col gap-8 px-6 py-16">
      <nav aria-label="Breadcrumb" class="text-muted-foreground text-sm">
        <a href="/" class="hover:text-foreground">Home</a>
        <span aria-hidden="true"> / </span>
        <span class="text-foreground">{course.title}</span>
      </nav>
      <header class="flex flex-col gap-2">
        <h1 class="text-3xl font-semibold tracking-tight">{course.title}</h1>
        <div
          class="text-muted-foreground flex flex-wrap items-center gap-2 text-sm"
        >
          <span>
            {course.category} <span aria-hidden="true">→</span>
            {course.subCategory}
          </span>
          <span
            class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-xs capitalize"
          >
            {course.difficulty}
          </span>
        </div>
        {course.summary && (
          <p class="text-muted-foreground">{course.summary}</p>
        )}
        <p class="text-muted-foreground">
          {course.lessons.length}
          lesson{course.lessons.length === 1 ? "" : "s"}
          ·
          {allParts.length}
          part{allParts.length === 1 ? "" : "s"}
          ·
          {totalMinutes(allParts)}
          min total
        </p>
        <div class="flex flex-col gap-1">
          <progress
            data-course-progress
            data-course={course.slug}
            data-total={allParts.length}
            class="h-1.5 w-full max-w-xs"
            max={allParts.length}
            value={0}
          >
            {allParts.length}
            parts
          </progress>
          <span
            data-course-progress-label
            class="text-muted-foreground text-xs"
          >
            0 of {allParts.length} parts completed
          </span>
        </div>
      </header>
      <div class="flex flex-col gap-5">
        {course.lessons.map((lesson) => (
          <section
            aria-labelledby={`lesson-${lesson.slug}`}
            class="border-border bg-card flex flex-col gap-3 rounded-lg border p-5"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 id={`lesson-${lesson.slug}`} class="text-lg font-medium">
                <span class="text-muted-foreground mr-2 tabular-nums">
                  {lesson.order}.
                </span>
                {lesson.title}
              </h2>
              <span class="text-muted-foreground text-sm whitespace-nowrap">
                {totalMinutes(lesson.parts)} min
              </span>
            </div>
            {lesson.summary && (
              <p class="text-muted-foreground text-sm">{lesson.summary}</p>
            )}
            <ol class="flex flex-col">
              {lesson.parts.map((part) => (
                <li>
                  <a
                    href={partHref(part)}
                    data-lesson-id={part.id}
                    class="hover:bg-muted/50 flex items-baseline gap-3 rounded-md px-2 py-2 text-sm transition-colors"
                  >
                    <span class="text-muted-foreground tabular-nums">
                      {lesson.order}.{part.data.order}
                    </span>
                    <span>{part.data.title}</span>
                    <span
                      data-check-slot
                      class="text-primary"
                      aria-hidden="true"
                    />
                    <span class="text-muted-foreground ml-auto text-xs whitespace-nowrap">
                      <span data-quiz-slot class="text-xs" />
                      {part.data.estimatedTime} min
                    </span>
                  </a>
                </li>
              ))}
            </ol>
            {lessonFirstPartHref(lesson) && (
              <a
                href={lessonFirstPartHref(lesson)}
                class="text-primary self-start text-sm underline-offset-4 hover:underline"
              >
                Start lesson →
              </a>
            )}
          </section>
        ))}
      </div>
    </main>
    <ProgressEnhance />
  </body>
</html>
