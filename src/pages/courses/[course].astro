---
import { getCourses, lessonHref } from "@/lib/courses";
import ProgressEnhance from "@/components/chrome/ProgressEnhance.astro";
import ThemeInit from "@/components/chrome/ThemeInit.astro";
import ThemeToggle from "@/components/chrome/ThemeToggle.astro";
import "@/styles/global.css";

export async function getStaticPaths() {
  const courses = await getCourses();
  return courses.map((course) => ({
    params: { course: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <title>{course.title} — Study Helper</title>
    <ThemeInit />
  </head>
  <body class="bg-background text-foreground">
    <ThemeToggle />
    <main class="mx-auto flex w-full max-w-3xl flex-col gap-8 px-6 py-16">
      <nav aria-label="Breadcrumb" class="text-muted-foreground text-sm">
        <a href="/" class="hover:text-foreground">Home</a>
        <span aria-hidden="true"> / </span>
        <span class="text-foreground">{course.title}</span>
      </nav>
      <header class="flex flex-col gap-2">
        <h1 class="text-3xl font-semibold tracking-tight">{course.title}</h1>
        <p class="text-muted-foreground">
          {course.lessons.length}
          lesson{course.lessons.length === 1 ? "" : "s"}
          ·{" "}
          {course.lessons.reduce(
            (total, lesson) => total + lesson.data.estimatedTime,
            0,
          )}
          min total
        </p>
        <div class="flex flex-col gap-1">
          <progress
            data-course-progress
            data-course={course.slug}
            data-total={course.lessons.length}
            class="h-1.5 w-full max-w-xs"
            max={course.lessons.length}
            value={0}
          >
            {course.lessons.length}
            lessons
          </progress>
          <span
            data-course-progress-label
            class="text-muted-foreground text-xs"
          >
            0 of {course.lessons.length} lessons completed
          </span>
        </div>
      </header>
      <ol class="flex flex-col gap-3">
        {course.lessons.map((lesson) => (
          <li>
            <a
              href={lessonHref(lesson)}
              data-lesson-id={lesson.id}
              class="border-border bg-card hover:border-primary/40 flex flex-col gap-1 rounded-lg border p-5 transition-colors"
            >
              <span class="flex items-baseline gap-2">
                <span class="text-muted-foreground text-sm tabular-nums">
                  {lesson.data.order}.
                </span>
                <span class="text-lg font-medium">{lesson.data.title}</span>
                <span
                  data-check-slot
                  class="text-primary text-sm"
                  aria-hidden="true"
                />
                <span class="text-muted-foreground ml-auto text-sm whitespace-nowrap">
                  <span data-quiz-slot class="text-xs" />
                  {lesson.data.estimatedTime} min
                </span>
              </span>
              <span class="text-muted-foreground text-sm">
                {lesson.data.summary}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </main>
    <ProgressEnhance />
  </body>
</html>
