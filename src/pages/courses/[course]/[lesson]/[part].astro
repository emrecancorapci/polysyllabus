---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Callout from "@/components/content/Callout.astro";
import CollapsibleSolution from "@/components/content/CollapsibleSolution.astro";
import DataPlot from "@/components/content/DataPlot.astro";
import Figure from "@/components/content/Figure.astro";
import NumericQuiz from "@/components/content/NumericQuiz.astro";
import Playground from "@/components/content/Playground.astro";
import Quiz from "@/components/content/Quiz.astro";
import LessonCompleteButton from "@/components/chrome/LessonCompleteButton.astro";
import Annotations from "@/components/chrome/Annotations.astro";
import MathText from "@/components/content/react/MathText";
import ProgressEnhance from "@/components/chrome/ProgressEnhance.astro";
import {
  flattenParts,
  getCourses,
  getPrevNext,
  partHref,
  partTypeLabel,
} from "@/lib/courses";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const parts = await getCollection("parts");
  return parts.map((part) => {
    const [course, lesson, partSlug] = part.id.split("/");
    return {
      params: { course, lesson, part: partSlug },
      props: { part },
    };
  });
}

const { part } = Astro.props;
const { Content, headings } = await render(part);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const [courseSlug, lessonSlug] = part.id.split("/");
const course = (await getCourses()).find((entry) => entry.slug === courseSlug);
const lesson = course?.lessons.find((entry) => entry.slug === lessonSlug);
const courseParts = course ? flattenParts(course) : [];
const allParts = await getCollection("parts");
const { prev, next } = getPrevNext(courseParts, part.id);
const courseName = course?.title ?? courseSlug;
const lessonName = lesson?.title ?? lessonSlug;
const position = lesson
  ? `${lesson.order}.${part.data.order}`
  : `${part.data.order}`;

// The complete set of MDX components parts may use (docs/content-components.md).
// Anything outside this map fails the build, which enforces the contract.
const contentComponents = {
  Callout,
  Quiz,
  CollapsibleSolution,
  Figure,
  DataPlot,
  Playground,
  NumericQuiz,
};

/** One outline link, reused by the desktop rail and the mobile contents. */
function outlineLink(
  item: (typeof courseParts)[number],
  lessonOrder: number,
): { href: string; label: string; title: string; current: boolean } {
  return {
    href: partHref(item),
    label: `${lessonOrder}.${item.data.order}`,
    title: item.data.title,
    current: item.id === part.id,
  };
}
---

<Base
  title={`${part.data.title} — ${lessonName} — PolySyllabus`}
  description={part.data.summary}
  lang={course?.language}
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-1 flex-col px-6 py-8 lg:flex-row lg:gap-10"
  >
    <aside class="hidden lg:block lg:w-60 lg:shrink-0">
      <nav
        aria-label="Course outline"
        class="sticky top-20 flex flex-col gap-6 max-lg:py-2"
      >
        <a
          href={`/courses/${courseSlug}/`}
          class="text-muted-foreground hover:text-foreground flex items-center gap-1.5 rounded-sm text-sm focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          {courseName}
        </a>
        {course?.lessons.map((entry) => (
          <div class="flex flex-col gap-0.5">
            <p class="text-foreground mt-1 px-2 text-sm font-medium">
              <span class="text-muted-foreground tabular-nums">
                {entry.order}.
              </span>{" "}
              {entry.title}
            </p>
            {entry.parts.map((item) => {
              const link = outlineLink(item, entry.order);
              return (
                <a
                  href={link.href}
                  aria-current={link.current ? "page" : undefined}
                  data-lesson-id={item.id}
                  class:list={[
                    "group flex items-baseline gap-2 rounded-md px-2 py-1.5 text-sm transition-colors",
                    link.current
                      ? "bg-muted text-foreground font-medium"
                      : "text-muted-foreground hover:bg-muted/50 hover:text-foreground focus-visible:bg-muted/50 focus-visible:outline-none",
                  ]}
                >
                  <span
                    class:list={[
                      "tabular-nums",
                      link.current ? "text-primary" : "",
                    ]}
                  >
                    {link.label}
                  </span>
                  <span class="min-w-0 truncate">{link.title}</span>
                  <span
                    data-check-slot
                    class="text-success ml-auto text-xs font-medium"
                    aria-hidden="true"
                  />
                </a>
              );
            })}
          </div>
        ))}
      </nav>
    </aside>

    <main
      id="main"
      class="flex min-w-0 flex-1 flex-col gap-6 max-lg:mx-auto max-lg:w-full max-lg:max-w-[42rem]"
    >
      <nav aria-label="Breadcrumb" class="text-muted-foreground text-sm">
        <a
          href="/"
          class="hover:text-foreground rounded-sm focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          Home
        </a>
        <span aria-hidden="true"> / </span>
        <a
          href={`/courses/${courseSlug}/`}
          class="hover:text-foreground rounded-sm focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none max-sm:hidden"
        >
          {courseName}
        </a>
        <span aria-hidden="true" class="max-sm:hidden"> / </span>
        <span aria-hidden="true" class="sm:hidden">…{" "}</span>
        <span class="text-foreground">{part.data.title}</span>
      </nav>

      <header class="flex flex-col gap-3">
        <p class="text-muted-foreground text-sm">
          Lesson {position}, {lessonName}
        </p>
        <h1
          class="font-heading text-4xl leading-tight font-semibold tracking-tight"
        >
          {part.data.title}
        </h1>
        <p class="text-muted-foreground max-w-prose text-pretty">
          {part.data.summary}
        </p>
        <p class="text-muted-foreground text-sm">
          {part.data.type !== "course" && (
            <span class="bg-muted text-muted-foreground me-2 inline-block rounded-full px-2 py-0.5 text-xs align-middle font-medium">
              {partTypeLabel(part.data.type)}
            </span>
          )}
          <span>About {part.data.estimatedTime} min</span>
          {part.data.prerequisites.length > 0 && (
            <span>
              {", "}
              Prerequisites:{" "}
              {part.data.prerequisites.map((id, index) => {
                const target = allParts.find((entry) => entry.id === id);
                return (
                  <>
                    {index > 0 && ", "}
                    {target ? (
                      <a
                        href={partHref(target)}
                        class="text-primary rounded-sm underline-offset-4 hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
                      >
                        {target.data.title}
                      </a>
                    ) : (
                      <span>{id}</span>
                    )}
                  </>
                );
              })}
            </span>
          )}
        </p>
      </header>

      <details class="border-border bg-card group rounded-lg border lg:hidden">
        <summary
          class="flex cursor-pointer select-none items-center justify-between px-4 py-3 text-sm font-medium focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          Course contents
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4 transition-transform group-open:rotate-180"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <div class="border-border border-t px-2 py-2">
          {course?.lessons.map((entry) => (
            <div class="flex flex-col gap-0.5">
              <p class="text-foreground mt-2 px-2 text-xs font-medium">
                <span class="text-muted-foreground tabular-nums">
                  {entry.order}.
                </span>{" "}
                {entry.title}
              </p>
              {entry.parts.map((item) => {
                const link = outlineLink(item, entry.order);
                return (
                  <a
                    href={link.href}
                    aria-current={link.current ? "page" : undefined}
                    data-lesson-id={item.id}
                    class:list={[
                      "flex items-baseline gap-2 rounded-md px-2 py-1.5 text-sm",
                      link.current
                        ? "bg-muted text-foreground font-medium"
                        : "text-muted-foreground hover:bg-muted/50 hover:text-foreground",
                    ]}
                  >
                    <span class="tabular-nums">{link.label}</span>
                    <span class="min-w-0 truncate">{link.title}</span>
                    <span
                      data-check-slot
                      class="text-success ml-auto text-xs font-medium"
                      aria-hidden="true"
                    />
                  </a>
                );
              })}
            </div>
          ))}
        </div>
      </details>

      <section
        aria-label="Learning objectives"
        class="grid-paper border-border rounded-lg border p-5"
      >
        <h2 class="text-sm font-semibold">Learning objectives</h2>
        <ol
          class="mt-2 flex list-decimal flex-col gap-1 pl-5 text-sm marker:text-muted-foreground/70 marker:tabular-nums"
        >
          {part.data.learningObjectives.map((objective) => (
            <li class="ps-1">
              <MathText text={objective} />
            </li>
          ))}
        </ol>
      </section>

      <article
        class="prose prose-neutral dark:prose-invert article-prose mt-2 max-w-none"
      >
        <Content components={contentComponents} />
      </article>

      <details
        data-annotation-section
        hidden
        class="border-border bg-card group rounded-lg border xl:hidden"
      >
        <summary
          class="flex cursor-pointer select-none items-center justify-between px-4 py-3 text-sm font-medium focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          Bookmarks &amp; notes
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4 transition-transform group-open:rotate-180"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <div class="border-border border-t px-2 py-2">
          <ul
            data-annotation-panel
            data-part-id={part.id}
            class="flex flex-col gap-0.5"
          ></ul>
        </div>
      </details>

      <div class="border-border mt-8 flex flex-col gap-5 border-t pt-6">
        <div class="flex justify-center">
          <LessonCompleteButton lessonId={part.id} />
        </div>
        <nav
          aria-label="Part navigation"
          class="grid grid-cols-1 gap-4 sm:grid-cols-2"
        >
          {prev ? (
            <a
              href={partHref(prev)}
              class="border-border bg-card hover:border-primary/40 flex min-w-0 flex-col gap-0.5 rounded-lg border p-3.5 focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
            >
              <span class="text-muted-foreground text-xs">Previous</span>
              <span class="truncate text-sm font-medium">
                {prev.data.title}
              </span>
            </a>
          ) : (
            <span aria-hidden="true" />
          )}
          {next ? (
            <a
              href={partHref(next)}
              class="border-border bg-card hover:border-primary/40 flex min-w-0 flex-col items-end gap-0.5 rounded-lg border p-3.5 text-right focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none max-sm:items-start max-sm:text-left"
            >
              <span class="text-muted-foreground text-xs">Next</span>
              <span class="truncate text-sm font-medium">
                {next.data.title}
              </span>
            </a>
          ) : (
            <span aria-hidden="true" />
          )}
        </nav>
      </div>
    </main>

    <aside class="hidden w-52 shrink-0 xl:block">
      <div class="sticky top-20 flex flex-col gap-6 pt-2">
        {tocHeadings.length > 0 && (
          <nav aria-label="On this page" class="flex flex-col gap-2">
            <p class="text-foreground text-sm font-medium">On this page</p>
            <ul class="flex flex-col">
              {tocHeadings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class:list={[
                      "text-muted-foreground hover:text-foreground block border-border border-l py-1 text-sm transition-colors focus-visible:border-primary focus-visible:text-foreground focus-visible:outline-none",
                      heading.depth === 2
                        ? "pl-3"
                        : "text-muted-foreground/70 border-l-transparent pl-6 text-xs",
                    ]}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <section data-annotation-section hidden class="flex flex-col gap-2">
          <p class="text-foreground text-sm font-medium">
            Bookmarks &amp; notes
          </p>
          <ul
            data-annotation-panel
            data-part-id={part.id}
            class="flex flex-col gap-0.5"
          ></ul>
        </section>
      </div>
    </aside>
  </div>
  <Annotations partId={part.id} />
  <ProgressEnhance />
</Base>
