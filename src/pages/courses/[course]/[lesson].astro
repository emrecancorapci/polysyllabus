---
import { getCollection, render } from "astro:content";
import "katex/dist/katex.min.css";
import "@/styles/global.css";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => {
    const [course, ...rest] = lesson.id.split("/");
    return {
      params: { course, lesson: rest.join("/") },
      props: { lesson },
    };
  });
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <title>{lesson.data.title} — Study Helper</title>
  </head>
  <body class="bg-background text-foreground">
    <main class="mx-auto flex max-w-2xl flex-col gap-6 px-6 py-12">
      <header class="flex flex-col gap-2">
        <p class="text-muted-foreground text-sm">
          {lesson.id}
          · {lesson.data.estimatedTime} min
        </p>
        <h1 class="text-3xl font-semibold tracking-tight">
          {lesson.data.title}
        </h1>
        <p class="text-muted-foreground">{lesson.data.summary}</p>
      </header>
      <section aria-label="Learning objectives" class="flex flex-col gap-2">
        <h2 class="text-lg font-semibold">Learning objectives</h2>
        <ul class="list-disc pl-6">
          {lesson.data.learningObjectives.map((objective) => (
            <li>{objective}</li>
          ))}
        </ul>
      </section>
      <article class="prose">
        <Content />
      </article>
    </main>
  </body>
</html>
