---
import { getCollection, render } from "astro:content";
import Callout from "@/components/content/Callout.astro";
import CollapsibleSolution from "@/components/content/CollapsibleSolution.astro";
import DataPlot from "@/components/content/DataPlot.astro";
import Figure from "@/components/content/Figure.astro";
import NumericQuiz from "@/components/content/NumericQuiz.astro";
import Playground from "@/components/content/Playground.astro";
import Quiz from "@/components/content/Quiz.astro";
import LessonCompleteButton from "@/components/chrome/LessonCompleteButton.astro";
import MathText from "@/components/content/react/MathText";
import ProgressEnhance from "@/components/chrome/ProgressEnhance.astro";
import {
  courseTitle,
  getPrevNext,
  lessonHref,
  sortByOrder,
} from "@/lib/courses";
import "katex/dist/katex.min.css";
import ThemeInit from "@/components/chrome/ThemeInit.astro";
import ThemeToggle from "@/components/chrome/ThemeToggle.astro";
import "@/styles/global.css";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => {
    const [course, ...rest] = lesson.id.split("/");
    return {
      params: { course, lesson: rest.join("/") },
      props: { lesson },
    };
  });
}

const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const [courseSlug] = lesson.id.split("/");
const allLessons = await getCollection("lessons");
const courseLessons = sortByOrder(
  allLessons.filter((entry) => entry.id.split("/")[0] === courseSlug),
);
const { prev, next } = getPrevNext(courseLessons, lesson.id);
const courseName = courseTitle(courseSlug);

// The complete set of MDX components lessons may use (docs/content-components.md).
// Anything outside this map fails the build, which enforces the contract.
const contentComponents = {
  Callout,
  Quiz,
  CollapsibleSolution,
  Figure,
  DataPlot,
  Playground,
  NumericQuiz,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <title>{lesson.data.title} — {courseName} — Study Helper</title>
    <ThemeInit />
  </head>
  <body class="bg-background text-foreground">
    <ThemeToggle />
    <div
      class="mx-auto flex w-full max-w-6xl flex-col px-6 py-10 lg:flex-row lg:gap-12"
    >
      <aside class="hidden lg:block lg:w-64 lg:shrink-0">
        <nav
          aria-label="Course outline"
          class="sticky top-10 flex flex-col gap-4"
        >
          <a
            href={`/courses/${courseSlug}/`}
            class="text-muted-foreground hover:text-foreground text-sm"
          >
            ← {courseName}
          </a>
          <ol class="flex flex-col gap-1">
            {courseLessons.map((entry) => {
              const current = entry.id === lesson.id;
              return (
                <li>
                  <a
                    href={lessonHref(entry)}
                    aria-current={current ? "page" : undefined}
                    data-lesson-id={entry.id}
                    class:list={[
                      "flex items-baseline gap-2 rounded-md px-2 py-1.5 text-sm",
                      current
                        ? "bg-muted text-foreground font-medium"
                        : "text-muted-foreground hover:bg-muted/50 hover:text-foreground",
                    ]}
                  >
                    <span class="tabular-nums">{entry.data.order}.</span>
                    <span>{entry.data.title}</span>
                    <span
                      data-check-slot
                      class="text-primary ml-auto"
                      aria-hidden="true"
                    />
                  </a>
                </li>
              );
            })}
          </ol>
          {tocHeadings.length > 0 && (
            <nav
              aria-label="On this page"
              class="border-border mt-4 flex flex-col gap-2 border-t pt-4"
            >
              <p class="text-foreground text-sm font-medium">On this page</p>
              <ul class="flex flex-col">
                {tocHeadings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class:list={[
                        "hover:text-foreground block py-0.5 text-sm",
                        heading.depth === 2
                          ? "text-muted-foreground"
                          : "text-muted-foreground/70 pl-3 text-xs",
                      ]}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </nav>
      </aside>

      <main class="flex min-w-0 flex-col gap-6">
        <nav aria-label="Breadcrumb" class="text-muted-foreground text-sm">
          <a href="/" class="hover:text-foreground">Home</a>
          <span aria-hidden="true"> / </span>
          <a href={`/courses/${courseSlug}/`} class="hover:text-foreground"
            >{courseName}</a
          >
          <span aria-hidden="true"> / </span>
          <span class="text-foreground">{lesson.data.title}</span>
        </nav>

        <header class="flex flex-col gap-3">
          <h1 class="text-3xl font-semibold tracking-tight">
            {lesson.data.title}
          </h1>
          <p class="text-muted-foreground">{lesson.data.summary}</p>
          <div
            class="text-muted-foreground flex flex-wrap items-center gap-2 text-sm"
          >
            <span>{lesson.data.estimatedTime} min</span>
            {lesson.data.prerequisites.length > 0 && (
              <span class="flex flex-wrap items-center gap-1">
                <span aria-hidden="true">·</span>
                <span>Prerequisites:</span>
                {lesson.data.prerequisites.map((id, index) => {
                  const target = allLessons.find((entry) => entry.id === id);
                  return (
                    <>
                      {index > 0 && <span aria-hidden="true">,</span>}
                      {target ? (
                        <a
                          href={lessonHref(target)}
                          class="text-primary hover:underline"
                        >
                          {target.data.title}
                        </a>
                      ) : (
                        <span>{id}</span>
                      )}
                    </>
                  );
                })}
              </span>
            )}
          </div>
        </header>

        <section
          aria-label="Learning objectives"
          class="border-border bg-muted/40 flex flex-col gap-2 rounded-lg border p-5"
        >
          <h2 class="text-sm font-semibold">Learning objectives</h2>
          <ul class="list-disc pl-5 text-sm">
            {lesson.data.learningObjectives.map((objective) => (
              <li>
                <MathText text={objective} />
              </li>
            ))}
          </ul>
        </section>

        <article
          class="prose prose-neutral dark:prose-invert max-w-none prose-a:text-primary prose-a:no-underline prose-a:underline-offset-4 hover:prose-a:underline prose-strong:text-foreground"
        >
          <Content components={contentComponents} />
        </article>

        <div class="flex justify-end">
          <LessonCompleteButton lessonId={lesson.id} />
        </div>

        <nav
          aria-label="Lesson navigation"
          class="border-border mt-4 flex items-stretch justify-between gap-4 border-t pt-6"
        >
          {prev ? (
            <a
              href={lessonHref(prev)}
              class="border-border bg-card hover:border-primary/40 flex min-w-0 flex-col gap-1 rounded-lg border p-4"
            >
              <span class="text-muted-foreground text-xs">Previous</span>
              <span class="truncate text-sm font-medium">
                {prev.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={lessonHref(next)}
              class="border-border bg-card hover:border-primary/40 flex min-w-0 flex-col items-end gap-1 rounded-lg border p-4 text-right"
            >
              <span class="text-muted-foreground text-xs">Next</span>
              <span class="truncate text-sm font-medium">
                {next.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      </main>
    </div>
    <ProgressEnhance />
  </body>
</html>
